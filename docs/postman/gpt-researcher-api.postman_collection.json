              "raw": "{\n  \"collection_name\": \"zotero-med\",\n  \"pdf_dir\": \"{{zoteroPdfDir}}\",\n  \"zotero_json_path\": \"{{zoteroJsonPath}}\",\n  \"bibtex_path\": \"{{zoteroBibPath}}\",\n  \"recursive\": true\n}"
            },
