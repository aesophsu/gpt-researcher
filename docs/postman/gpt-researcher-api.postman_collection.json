                "zotero-ingest"
              ]
            }
          }
        },
        {
          "name": "Medical Async Jobs",
          "item": [
            {
              "name": "Medical Ingest Async",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "if (body.job_id) {",
                      "  pm.collectionVariables.set('medicalJobId', body.job_id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"doc_path\": \"{{docPath}}\",\n  \"collection_name\": \"med-default\",\n  \"recursive\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/medical/ingest/async",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "medical",
                    "ingest",
                    "async"
                  ]
                }
              }
            },
            {
              "name": "Medical Zotero Ingest Async",
              "event": [
